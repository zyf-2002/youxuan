# 复制成 .env 再填自己的值。.env 已在 .gitignore 里，不会被提交。
# start-all.sh 会自动读取它并注入到 JVM 环境变量。

# 大模型（DeepSeek，OpenAI 兼容接口）
# 不填也能启动：知识库入库/检索完全可用，只有对话与检索管线里的 LLM 环节会降级
DEEPSEEK_API_KEY=

# 精排（Jina Rerank）
# 不填则 RerankService.enabled() 为 false，检索会跳过精排、保留召回顺序
RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
RERANK_MODEL=jina-reranker-v2-base-multilingual
RERANK_API_KEY=

# 本地 MySQL 密码（application.yaml 里是 ${MYSQL_PASSWORD:root}，start-all.sh 会把它转发给 JVM）
MYSQL_PASSWORD=
